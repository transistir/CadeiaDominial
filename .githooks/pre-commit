#!/usr/bin/env bash
set -euo pipefail

# Trava de 400 linhas por arquivo (Etapa 0 — docs/refatoracao/PLANO_400_LINHAS.md).
# Roda só quando algo vigiado (.py/.js/.html/.css) está no stage.

cd "$(git rev-parse --show-toplevel)"

staged_vigiado=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py' '*.js' '*.html' '*.css' || true)

if [ -z "${staged_vigiado}" ]; then
    exit 0
fi

if ! python3 scripts/check_file_size.py --quiet; then
    echo "Bloqueado: arquivo acima de 400 linhas. Veja docs/refatoracao/PLANO_400_LINHAS.md" >&2
    exit 1
fi
