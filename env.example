# Configurações do Django
DEBUG=False
SECRET_KEY=sua_chave_secreta_muito_segura_aqui_$(date +%s)
ALLOWED_HOSTS=localhost,127.0.0.1,seu-dominio.com

# Configurações do Banco de Dados
DB_NAME=cadeia_dominial
DB_USER=cadeia_user
DB_PASSWORD=sua_senha_segura_aqui
DB_HOST=db
DB_PORT=5432

# Configurações do SSL/Let's Encrypt
DOMAIN_NAME=seu-dominio.com
CERTBOT_EMAIL=seu-email@exemplo.com

# Configurações de Email (opcional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua_senha_de_app

# Configurações de Timezone
TIME_ZONE=America/Sao_Paulo

# Configurações de Log
LOG_LEVEL=INFO

# Configurações do Usuário Admin (OBRIGATÓRIO)
# ⚠️  IMPORTANTE: Defina uma senha forte com pelo menos 8 caracteres!
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@cadeiadominial.com.br
ADMIN_PASSWORD=sua_senha_admin_muito_segura_aqui

# Configurações do módulo IA/OCR (issue #258)
# Backend de processamento (dotted path). O cliente HTTP real do serviço OCR
# chega na issue seguinte (I-2); por enquanto o StubBackend falha com código
# BACKEND_NAO_IMPLEMENTADO.
OCR_BACKEND=ia_ocr.backends.StubBackend
# Lease do worker em segundos — precisa exceder o deadline do backend
# (~37 s/página medidos no spike). Default: 3600.
OCR_JOB_TIMEOUT_SECONDS=3600
# Intervalo (s) do loop contínuo do comando process_ocr_queue. Default: 30.
OCR_QUEUE_INTERVAL_SECONDS=30
# Issue #262 (I-5): permite finalizar a revisão quando o serviço de extração
# NÃO devolveu nenhum ato (paliativa até o segmentador do ocr-service#14).
# Não ligar em produção.
OCR_PERMITIR_FINALIZAR_SEM_ATOS=False
