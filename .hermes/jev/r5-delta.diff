+class AdminEdicaoImovelEscopoTest(SegregacaoBaseTestCase):
+    """P1-H (#132): save_model revalida usuario_tem_ti_inteira quando
+    terra_indigena_id muda na edição, e alterar_ti_view exige TI inteira
+    no destino (dropdown coerente — só TIs inteiras + TI atual).
+
+    Cenário comum: staff com UserTI na tis_a (TI inteira) + UserImovel legado
+    em imóvel da tis_b (só legado → NÃO tem TI inteira em tis_b).
+    Tentar mover imóvel de tis_a para tis_b deve ser barrado.
+    """
+
+    @classmethod
+    def setUpTestData(cls):
+        super().setUpTestData()
+        # Staff com UserTI em tis_a (TI inteira)
+        cls.staff_misto = User.objects.create_user(
+            username='staff_misto', password='senha-staff-misto',
+        )
+        cls.staff_misto.is_staff = True
+        cls.staff_misto.save(update_fields=['is_staff'])
+        ct = ContentType.objects.get_for_model(Imovel)
+        perm_change = Permission.objects.get(content_type=ct, codename='change_imovel')
+        cls.staff_misto.user_permissions.add(perm_change)
+        # TI inteira em tis_a
+        UserTI.objects.create(
+            user=cls.staff_misto, tis=cls.tis_a, atribuido_por=cls.superuser
+        )
+        # Imóvel legado em tis_b (só visível por UserImovel, NÃO é TI inteira)
+        cls.imovel_legado_b = Imovel.objects.create(
+            nome='Legado B', matricula='LEG-B',
+            terra_indigena_id=cls.tis_b,
+            proprietario=cls.proprietario, cartorio=cls.cartorio,
+        )
+        UserImovel.objects.create(
+            user=cls.staff_misto, imovel=cls.imovel_legado_b,
+            atribuido_por=cls.superuser,
+        )
+        # Imóvel em tis_a que será alvo do teste de mover
+        cls.imovel_alvo = Imovel.objects.create(
+            nome='Alvo A', matricula='ALV-A',
+            terra_indigena_id=cls.tis_a,
+            proprietario=cls.proprietario, cartorio=cls.cartorio,
+        )
+
+    def setUp(self):
+        self.client = Client()
+
+    def _get_change_url(self, imovel):
+        return reverse('admin:dominial_imovel_change', args=[imovel.id])
+
+    def _get_alterar_ti_url(self, imovel):
+        return reverse('admin:dominial_imovel_alterar_ti', args=[imovel.id])
+
+    def _change_post_data(self, imovel, terra_indigena_id):
+        """Campos mínimos para o changeform POST do admin."""
+        return {
+            'nome': imovel.nome,
+            'matricula': imovel.matricula,
+            'tipo_documento_principal': imovel.tipo_documento_principal,
+            'terra_indigena_id': terra_indigena_id,
+            'proprietario': imovel.proprietario_id,
+            'cartorio': imovel.cartorio_id,
+            'arquivado': imovel.arquivado,
+            'observacoes': imovel.observacoes or '',
+        }
+
+    def test_changeform_nao_move_imovel_para_ti_so_legado(self):
+        """P1-H (a): POST no changeform tentando mover imóvel de tis_a para
+        tis_b (onde o staff só tem UserImovel legado) NÃO altera o banco."""
+        self.client.force_login(self.staff_misto)
+        self.imovel_alvo.refresh_from_db()
+        ti_original = self.imovel_alvo.terra_indigena_id_id
+
+        data = self._change_post_data(self.imovel_alvo, self.tis_b.id)
+        response = self.client.post(self._get_change_url(self.imovel_alvo), data)
+
+        # Pode ser 200 (form inválido — TI fora do queryset) ou 403
+        # (save_model barrou). O árbitro é o banco.
+        self.assertIn(response.status_code, (200, 403))
+        self.imovel_alvo.refresh_from_db()
+        self.assertEqual(self.imovel_alvo.terra_indigena_id_id, ti_original)
+
+    def test_alterar_ti_view_destino_legado_eh_barrado(self):
+        """P1-H (b): POST na alterar_ti_view com destino tis_b (só legado) →
+        403 PermissionDenied e imóvel continua na TI original."""
+        self.client.force_login(self.staff_misto)
+        self.imovel_alvo.refresh_from_db()
+        ti_original = self.imovel_alvo.terra_indigena_id_id
+
+        response = self.client.post(
+            self._get_alterar_ti_url(self.imovel_alvo),
+            {'nova_ti': self.tis_b.id, 'motivo': 'teste'},
+        )
+
+        self.assertEqual(response.status_code, 403)
+        self.imovel_alvo.refresh_from_db()
+        self.assertEqual(self.imovel_alvo.terra_indigena_id_id, ti_original)
+
+    def test_alterar_ti_view_para_ti_com_userti_funciona(self):
+        """P1-H (c): se o staff tem UserTI em ambas as TIs, a mudança ocorre."""
+        # Concede TI inteira em tis_b também
+        UserTI.objects.create(
+            user=self.staff_misto, tis=self.tis_b, atribuido_por=self.superuser
+        )
+        self.client.force_login(self.staff_misto)
+        self.imovel_alvo.refresh_from_db()
+
+        response = self.client.post(
+            self._get_alterar_ti_url(self.imovel_alvo),
+            {'nova_ti': self.tis_b.id, 'motivo': 'ok'},
+            follow=False,
+        )
+
+        # Redireciona após sucesso
+        self.assertEqual(response.status_code, 302)
+        self.imovel_alvo.refresh_from_db()
+        self.assertEqual(self.imovel_alvo.terra_indigena_id_id, self.tis_b.id)
 
 
