+        self.pessoa = Pessoas.objects.create(nome='Prop Chain')
+        self.imovel = Imovel.objects.create(
+            nome='Imóvel Chain', matricula='CH1',
+            terra_indigena_id=self.tis, cartorio=self.cartorio,
